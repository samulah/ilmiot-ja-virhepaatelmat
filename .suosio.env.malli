# Malli tiedostolle .suosio.env — kopioi tämä nimelle .suosio.env ja täytä.
#
#   cp .suosio.env.malli .suosio.env
#
# .suosio.env on .gitignoressa. Älä kirjoita kannan osoitetta, salasanaa tai
# palvelintunnuksia mihinkään versionhallittuun tiedostoon — ei tähän malliin,
# ei skriptin oletusarvoksi, ei MUUTOSLOKIin.

# ── Liikennekanta (luku) ────────────────────────────────────────────────
# Tunnus luodaan scripts/suosio_lukijatunnus.sql:llä.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=ilmiot_lukija
PGPASSWORD=

# ── Kysely ──────────────────────────────────────────────────────────────
# Palauta KOLME saraketta päivätasolla: polku (text), pvm (date), nayttoja (int).
# Kaikki ikkunointi ja ranking tehdään Pythonissa, joten kyselyn ei tarvitse
# tietää mistään muusta kuin omasta tähtimallistaan. Parametrit %(alku)s ja
# %(loppu)s ovat 30 pv:n ikkunan päivärajat, molemmat mukaan lukien.
#
# Aja ensin `python3 scripts/paivita_suosio.py --skeema` nähdäksesi taulut.
#
# Kolme asiaa jotka kyselyn on hoidettava, tai luvut eivät kerro lukijoista:
#
#   1. BOTIT POIS. Lokipohjainen faktataulu on täynnä crawlereita. GSC:n mukaan
#      sivusto saa ~82 klikkiä/kk; jos kysely palauttaa tuhansia, ero on botteja.
#   2. VAIN ONNISTUNEET HTML-PYYNNÖT. status = 200, ei kuvia eikä css/js-tiedostoja.
#   3. UNIIKIT JOS MAHDOLLISTA. Jos sessio- tai kävijädimensio on olemassa,
#      COUNT(DISTINCT sessio) on parempi mittari kuin rivimäärä.
#
# Rivinjatko kenoviivalla ei toimi — kirjoita kysely yhdelle riville.
#
# Esimerkki (KORVAA omilla taulu- ja sarakenimilläsi):
# SUOSIO_SQL=SELECT d.polku AS polku, p.pvm AS pvm, COUNT(DISTINCT f.sessio_id)::int AS nayttoja FROM fakta.sivunaytto f JOIN dim.sivu d ON d.sivu_avain = f.sivu_avain JOIN dim.paiva p ON p.paiva_avain = f.paiva_avain WHERE p.pvm BETWEEN %(alku)s AND %(loppu)s AND NOT f.on_botti AND f.status = 200 GROUP BY 1, 2
SUOSIO_SQL=

# ── Google-haku (valinnainen) ───────────────────────────────────────────
# Palauta: polku (text), pvm (date), lauseke (text), naytot (int), klikit (int),
# sija (float). Grain saa olla hieno — summaus tehdään Pythonissa.
#
# Tämä on eri asia kuin sivunäytöt: näyttö tarkoittaa että sivu näkyi
# hakutuloksissa, ei että joku luki sen. Siksi googlatuimmat-järjestys poikkeaa
# luetuimmista, ja se ero on itsessään tieto — sivu jolla on paljon näyttöjä ja
# vähän lukukertoja on title- tai kuvausongelma, ei sisältöongelma.
#
# Jos tämä jätetään tyhjäksi, googlatuimmat-lohko jää pois eikä muu putki
# häiriinny.
#
# Huom: Google Search Consolen data laahaa 2–3 vrk, joten tuoreimmat päivät
# ovat aina vajaita.
SUOSIO_SQL_GSC=

# ── Siirto livepalvelimelle (--laheta) ──────────────────────────────────
# Hakemiston on oltava olemassa palvelimella ennen ensimmäistä siirtoa.
SFTP_HOST=
SFTP_USER=
SFTP_PORT=22
SFTP_KEY=/home/samu/.ssh/id_ed25519_ilmiot
SFTP_POLKU=/public_html/data

# sftp-binäärin polku. Jätä tyhjäksi — skripti etsii sen PATH:ista ja
# tunnetuista paikoista (ml. Asustorin /usr/builtin/bin/sftp). Täytä vain jos
# binääri on jossain epätavallisessa paikassa.
SFTP_BIN=
